# Frontend / AI
GEMINI_API_KEY=""
APP_URL="https://panel.sitindia.in"

# Backend
NODE_ENV="production"
API_HOST="127.0.0.1"
API_PORT="4000"
SESSION_COOKIE_NAME="hostadmin_session"
SESSION_TTL_MS="28800000"

# Generate with: node -e "console.log(require('bcryptjs').hashSync('CHANGE_ME', 12))"
MASTER_USERNAME="superadmin"
MASTER_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH"

# BIND9
BIND_ZONE_DIR="/etc/bind/zones"
BIND_RELOAD_COMMAND="rndc reload"

# Hosting / Nginx
HOSTING_HOME="/home"
NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"
NGINX_SITES_ENABLED="/etc/nginx/sites-enabled"
NGINX_BINARY="nginx"
NGINX_RELOAD_BINARY="systemctl"
DEFAULT_PHP_SOCKET="/run/php/php8.3-fpm.sock"

# phpMyAdmin / Roundcube
PHPMYADMIN_ROOT="/usr/share/phpmyadmin"
PHPMYADMIN_HOST="phpmyadmin.sitindia.in"
ROUNDCUBE_ROOT="/var/lib/roundcube"
WEBMAIL_HOST="webmail.sitindia.in"
INTEGRATION_SITES_AVAILABLE="/etc/nginx/sites-available"
INTEGRATION_SITES_ENABLED="/etc/nginx/sites-enabled"
